.op-page {
  width: 100vw;
  height: 100vh;
  background: #0f0f1a;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.op-top {
  padding: 16rpx 24rpx;
  background: rgba(0,0,0,0.4);
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.opt-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff8c00;
}

.opt-ws {
  display: flex;
  align-items: center;
}

.opt-ws-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #666;
  margin-right: 8rpx;
}

.opt-ws.connected .opt-ws-dot { background: #00ff88; }
.opt-ws.connecting .opt-ws-dot { background: #ffaa00; animation: pulse 1s infinite; }
.opt-ws.disconnected .opt-ws-dot { background: #ff4444; }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.opt-ws-txt {
  font-size: 20rpx;
  color: #888;
}

.opt-ws-set {
  font-size: 28rpx;
  margin-left: 12rpx;
  padding: 4rpx 8rpx;
}

/* Ops actions */
.ops-actions {
  display: flex;
  margin-top: 16rpx;
}

.op-btn-sm {
  width: 160rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  background: rgba(255,140,0,0.2);
  color: #ff8c00;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255,140,0,0.3);
  padding: 0;
  margin: 0 10rpx;
}

/* 状态区 */
.op-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 20rpx;
  flex-shrink: 0;
}

.ops-icon { font-size: 60rpx; margin-bottom: 10rpx; }

.ops-txt {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.ops-sub {
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
}

.ops-countdown {
  font-size: 48rpx;
  font-weight: 900;
  color: #ff8c00;
  margin-top: 16rpx;
}

.op-btn-cancel {
  margin-top: 20rpx;
  width: 240rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  background: rgba(255,255,255,0.1);
  color: #ccc;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.15);
  padding: 0;
}

/* 球员选择 */
.op-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.opb-label {
  font-size: 26rpx;
  color: #ff8c00;
  font-weight: bold;
  padding: 16rpx 24rpx 8rpx;
}

.opb-team-row {
  padding: 0 24rpx 12rpx;
}

.opb-picker {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.12);
  color: #ddd;
  font-size: 26rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

.opb-list {
  flex: 1;
  padding: 0 20rpx;
}

.opb-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.opb-card.sel {
  background: rgba(255,140,0,0.15);
  border-color: #ff8c00;
}

.opbc-left { display: flex; align-items: center; }

.opbc-num {
  font-size: 26rpx;
  font-weight: bold;
  color: #ff8c00;
  margin-right: 12rpx;
  width: 50rpx;
}

.opbc-name {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 10rpx;
}

.opbc-pos {
  font-size: 20rpx;
  color: #888;
  background: rgba(255,255,255,0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.opbc-stats { text-align: right; }

.opbcs {
  display: block;
  font-size: 18rpx;
  color: #999;
}

/* 开始按钮 */
.op-btn-go {
  margin: 16rpx 24rpx 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #ff8c00, #ff4444);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  border: none;
  padding: 0;
}

.op-btn-go[disabled] {
  background: rgba(255,255,255,0.08);
  color: #666;
}

/* 排行榜 */
.op-lb {
  padding: 0 24rpx 30rpx;
}

.oplb-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #ff8c00;
  margin-bottom: 10rpx;
}

.oplb-row {
  display: flex;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.oplb-header { border-bottom-color: rgba(255,140,0,0.3); }

.oplb-rank { width: 50rpx; font-size: 20rpx; color: #888; text-align: center; }
.oplb-name { flex: 1; font-size: 22rpx; color: #fff; }
.oplb-score { width: 80rpx; font-size: 20rpx; color: #ff8c00; text-align: center; }
.oplb-games { width: 80rpx; font-size: 20rpx; color: #888; text-align: center; }

.oplb-list {
  max-height: 280rpx;
}

.op-status.error { background: none; }
.op-status.error .ops-txt { color: #ff4444; }
